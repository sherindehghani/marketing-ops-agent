# Copy to .env beside docker-compose.yaml.
# Sample questions work with both keys empty.
OPENAI_API_KEY=

# For a custom OpenAI-compatible provider, set its key, base URL and model.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# For Hooshi, set LLM_API_KEY to your Hooshi API key and use:
# LLM_BASE_URL=https://api.hooshi.ai/v1
# LLM_MODEL=openai/gpt-5.4-mini

# Local ports and maximum concurrent questions per API replica.
FRONTEND_PORT=8501
API_PORT=8080
API_CONCURRENCY=8
